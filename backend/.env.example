# ==============================================================================
# SmartSupport AI — Backend Environment Configuration (.env.example)
#
# Instructions:
# 1. Copy this file to `backend/.env`.
# 2. Fill in values appropriate for your environment (development or production).
# 3. NEVER commit real credentials, production secrets, or API keys to Git.
# ==============================================================================

# Server port (defaults to 5000 if not specified, or assigned by hosting provider)
PORT=5000

# Application environment ("development", "production", or "test")
NODE_ENV=production

# PostgreSQL connection string used by Prisma ORM
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/smartsupport?schema=public"

# Secret key used to sign and verify JSON Web Tokens (JWT)
# In production, use a high-entropy cryptographically secure random string
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Token expiration timeframe (e.g., "7d", "24h")
JWT_EXPIRES_IN=7d

# Allowed frontend URL origin for CORS
# In production: https://app.yourdomain.com
# In local development: http://localhost:3000 or http://localhost:5173
FRONTEND_URL=http://localhost:3000

# Google Gemini API key for ticket analysis
# Obtain key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
