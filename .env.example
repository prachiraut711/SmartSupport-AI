# ==============================================================================
# SmartSupport AI — Environment Configuration Template (.env.example)
#
# Instructions:
# 1. Copy this file to `.env` in the root (or create separate `.env` files in
#    `backend/.env` and `frontend/.env`).
# 2. Populate the variables with your environment-specific values.
# 3. NEVER commit real credentials, production secrets, or API keys to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Service Configuration
# ------------------------------------------------------------------------------

# Server port (e.g., 5000 locally, or provided automatically by cloud platform)
PORT=5000

# Application environment ("development", "production", or "test")
NODE_ENV=production

# PostgreSQL connection string used by Prisma ORM
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
# Example Production: postgresql://postgres_user:secure_password@db-host.internal:5432/smartsupport_prod?schema=public
# Example Local Dev:  postgresql://postgres:postgrespassword@localhost:5432/smartsupport?schema=public
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/smartsupport?schema=public"

# Secret key used to sign and verify JSON Web Tokens (JWT)
# In production, use a strong, cryptographically secure random string (minimum 32-64 characters)
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Token expiration timeframe (e.g., "7d", "24h", "1h")
JWT_EXPIRES_IN=7d

# Frontend client URL (allowed origin for CORS middleware)
# In production: https://app.yourdomain.com
# In local dev:   http://localhost:3000 (Docker) or http://localhost:5173 (Vite dev)
FRONTEND_URL=http://localhost:3000

# Google Gemini API Key for AI ticket analysis (summaries, categories, suggested replies)
# Obtain from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# PostgreSQL Local / Docker Compose Configuration (Optional for local container)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=smartsupport
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Frontend Client Configuration (Vite)
# ------------------------------------------------------------------------------

# Base URL for the backend REST API consumed by the React application
# Local development: http://localhost:5000/api
# Production behind reverse proxy / Nginx: /api
# Production separate domain: https://api.yourdomain.com/api
VITE_API_URL=http://localhost:5000/api
