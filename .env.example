# ==============================================================================
# SmartSupport AI — Root Environment Configuration Example
# Copy this file to .env or place corresponding variables in backend/frontend .env
# NEVER commit real credentials, production secrets, or API keys to Git.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# PostgreSQL Docker Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=smartsupport
POSTGRES_PORT=5432

# Database Connection URL (Prisma)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/smartsupport?schema=public

# Authentication (JWT)
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=24h

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Client-Side Configuration (Vite)
VITE_API_URL=http://localhost:5000/api
