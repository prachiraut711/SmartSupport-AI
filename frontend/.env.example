# ==============================================================================
# SmartSupport AI — Frontend Environment Configuration (.env.example)
#
# Instructions:
# 1. Copy this file to `frontend/.env` or `frontend/.env.local`.
# 2. Configure the backend REST API endpoint for the frontend client.
# ==============================================================================

# Base URL of the SmartSupport AI Backend REST API
# - Local development (direct to backend): http://localhost:5000/api
# - Containerized / Nginx reverse proxy: /api
# - Production separate host: https://api.yourdomain.com/api
VITE_API_URL=http://localhost:5000/api
